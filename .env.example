# Copy to .env.local and fill in. Only variables starting with VITE_ reach the browser, so never put secrets here:
# anything in this file is visible to every user of the built site.

# Base URL of the candidate API, without a trailing slash, e.g. https://api.example.com/resume-finder
# Leave empty to use the built-in sample data (4,860 invented candidates, searched in the browser).
VITE_API_BASE_URL=
